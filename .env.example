# Bot
BOT_TOKEN=123456789:ABCdefGhIjKlMnOpQrStUvWxYz

# Database (Neon, Supabase, local, etc.)
DATABASE_URL=postgresql://user:pass@host:5432/dbname
DB_POOL_MIN=10
DB_POOL_MAX=20

# Gameplay
DIG_COOLDOWN_SECONDS=3600
DIG_MIN_KG=1.0
DIG_MAX_KG=7.0
DIG_PRECISION=1

# Maintenance
HISTORY_RETENTION_HOURS=48
CLEANUP_INTERVAL_SECONDS=3600

# Performance
LEADERBOARD_CACHE_TTL=30

# Rate limiting
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# Web
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Redis (required for caching, rate limiting, sessions)
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Sentry (optional, for error tracking)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Admin panel (comma-separated Telegram user IDs)
ADMIN_USER_IDS=123456789,987654321
ADMIN_SESSION_SECRET=changeme_please_use_strong_secret

# Daily bonus
DAILY_BONUS_ENABLED=true
DAILY_BONUS_BASE_KG=0.5
DAILY_BONUS_STREAK_MULTIPLIER=0.1
DAILY_BONUS_MAX_STREAK=30

# Achievements
ACHIEVEMENTS_ENABLED=true

# Anti-cheat
ANTICHEAT_ENABLED=true
ANTICHEAT_MAX_KG_PER_HOUR=50.0
ANTICHEAT_MIN_DIG_INTERVAL=0.5